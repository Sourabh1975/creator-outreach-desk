{
  "manifest_version": 3,
  "name": "Creator Desk WhatsApp Auto-Sender",
  "version": "1.0.0",
  "description": "Automatically clicks Send on WhatsApp Web for Creator Desk outreach links without manual pressing.",
  "permissions": ["storage"],
  "host_permissions": [
    "https://web.whatsapp.com/*"
  ],
  "content_scripts": [
    {
      "matches": ["https://web.whatsapp.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": "icon.png"
  },
  "icons": {
    "48": "icon.png",
    "128": "icon.png"
  }
}